{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "OmniPdM Fleet Overview — 관리자 시점. 전체 장비 위험도 요약 + 알람 카운트 + 최근 알람 이력. 행 클릭으로 Device Detail drill-down.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "uid": "omnipdm-overview",
  "title": "OmniPdM — Fleet Overview",
  "tags": ["omnipdm", "pdm", "tier1", "overview"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "weekStart": "",
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "1h"]
  },
  "style": "dark",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Critical 알람 (최근 1시간)",
      "datasource": { "type": "postgres", "uid": "omnipdm-tsdb" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT count(*) AS value FROM alerts WHERE time > now() - interval '1 hour' AND risk_level = 'Critical'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          },
          "unit": "short",
          "decimals": 0
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value_and_name",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Warning 알람 (최근 1시간)",
      "datasource": { "type": "postgres", "uid": "omnipdm-tsdb" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT count(*) AS value FROM alerts WHERE time > now() - interval '1 hour' AND risk_level = 'Warning'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "orange", "value": 10 }
            ]
          },
          "unit": "short",
          "decimals": 0
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value_and_name",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "활성 장비 (최근 5분)",
      "datasource": { "type": "postgres", "uid": "omnipdm-tsdb" },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "description": "최근 5분 내 telemetry 를 발신한 distinct device 수. 0 = 모든 장비 미발신(통신 두절 의심)이라 red.",
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT count(DISTINCT device_id) AS value FROM telemetry WHERE time > now() - interval '5 minutes'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "green", "value": 3 }
            ]
          },
          "unit": "short",
          "decimals": 0
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value_and_name",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "최근 1시간 예측 건수",
      "datasource": { "type": "postgres", "uid": "omnipdm-tsdb" },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT count(*) AS value FROM predictions WHERE time > now() - interval '1 hour'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "#3ee68b" },
          "unit": "short",
          "decimals": 0
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value_and_name",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "id": 5,
      "type": "table",
      "title": "장비별 최신 위험 상태 (행 클릭 → Device Detail)",
      "datasource": { "type": "postgres", "uid": "omnipdm-tsdb" },
      "gridPos": { "h": 10, "w": 14, "x": 0, "y": 5 },
      "description": "지난 24시간 발신한 장비 목록. device_id 셀 클릭 시 Device Detail 대시보드로 drill-down. (24h 범위는 의도 — 1h 이내 미발신 장비도 목록에 노출).",
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT DISTINCT ON (device_id) device_id, dataset_key, risk_level, round(risk_score::numeric, 3) AS risk_score, round(failure_probability::numeric, 3) AS failure_prob, round(rul_norm::numeric, 3) AS rul_norm, time AS last_seen FROM predictions WHERE time > now() - interval '24 hours' ORDER BY device_id, time DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "left", "displayMode": "auto" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "risk_level" },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  { "type": "value", "options": { "Critical": { "color": "red",    "index": 0 } } },
                  { "type": "value", "options": { "Warning":  { "color": "orange", "index": 1 } } },
                  { "type": "value", "options": { "Advisory": { "color": "yellow", "index": 2 } } },
                  { "type": "value", "options": { "Normal":   { "color": "green",  "index": 3 } } }
                ]
              },
              { "id": "custom.displayMode", "value": "color-background" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "device_id" },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Device Detail",
                    "url": "/d/omnipdm-device/omnipdm-device-detail?var-device_id=${__value.raw}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "risk_score", "desc": true }],
        "footer": { "show": false, "reducer": ["sum"], "fields": "" }
      }
    },
    {
      "id": 6,
      "type": "piechart",
      "title": "위험 등급 분포 (최근 1시간)",
      "datasource": { "type": "postgres", "uid": "omnipdm-tsdb" },
      "gridPos": { "h": 10, "w": 10, "x": 14, "y": 5 },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT risk_level AS metric, count(*) AS value FROM predictions WHERE time > now() - interval '1 hour' GROUP BY risk_level"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "mappings": [],
          "unit": "short"
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Critical" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] },
          { "matcher": { "id": "byName", "options": "Warning" },  "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }] },
          { "matcher": { "id": "byName", "options": "Advisory" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } }] },
          { "matcher": { "id": "byName", "options": "Normal" },   "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] }
        ]
      },
      "options": {
        "displayLabels": ["percent"],
        "legend": { "displayMode": "list", "placement": "bottom", "values": ["value"] },
        "pieType": "donut",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "tooltip": { "mode": "single" }
      }
    },
    {
      "id": 7,
      "type": "table",
      "title": "최근 알람 이력 (최근 30분)",
      "datasource": { "type": "postgres", "uid": "omnipdm-tsdb" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 15 },
      "description": "실시간 알람 패널 — 30분은 의도. 장기 이력은 Explore 또는 별도 대시보드 영역.",
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT time, device_id, dataset_key, risk_level, round(risk_score::numeric, 3) AS risk_score, channel, notify_result FROM alerts WHERE time > now() - interval '30 minutes' ORDER BY time DESC LIMIT 200"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "left", "displayMode": "auto" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "risk_level" },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  { "type": "value", "options": { "Critical": { "color": "red",    "index": 0 } } },
                  { "type": "value", "options": { "Warning":  { "color": "orange", "index": 1 } } },
                  { "type": "value", "options": { "Advisory": { "color": "yellow", "index": 2 } } },
                  { "type": "value", "options": { "Normal":   { "color": "green",  "index": 3 } } }
                ]
              },
              { "id": "custom.displayMode", "value": "color-background" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "notify_result" },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  { "type": "value", "options": { "SENT":         { "color": "green",  "index": 0 } } },
                  { "type": "value", "options": { "FILTERED":     { "color": "gray",   "index": 1 } } },
                  { "type": "value", "options": { "RATE_LIMITED": { "color": "yellow", "index": 2 } } },
                  { "type": "value", "options": { "FAILED":       { "color": "red",    "index": 3 } } }
                ]
              },
              { "id": "custom.displayMode", "value": "color-background" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "device_id" },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Device Detail",
                    "url": "/d/omnipdm-device/omnipdm-device-detail?var-device_id=${__value.raw}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "footer": { "show": false, "reducer": ["sum"], "fields": "" }
      }
    }
  ],
  "templating": { "list": [] }
}
