{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "OmniPdM Device Detail — 운영자 시점. 장비 1대 deep-dive. 현재 상태 + Live Telemetry + XAI 기여도 + 위험도 추세 + 알람 이력.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "uid": "omnipdm-device",
  "title": "OmniPdM — Device Detail",
  "tags": ["omnipdm", "pdm", "tier1", "device"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "weekStart": "",
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "1h"]
  },
  "style": "dark",
  "templating": {
    "list": [
      {
        "name": "device_id",
        "label": "Device",
        "type": "query",
        "datasource": { "type": "postgres", "uid": "omnipdm-tsdb" },
        "query": "SELECT DISTINCT device_id FROM predictions ORDER BY device_id",
        "refresh": 1,
        "includeAll": false,
        "multi": false,
        "sort": 1,
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "현재 위험 등급",
      "datasource": { "type": "postgres", "uid": "omnipdm-tsdb" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT risk_level AS value FROM predictions WHERE device_id = '$device_id' ORDER BY time DESC LIMIT 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            { "type": "value", "options": { "Critical": { "color": "red",    "index": 0, "text": "Critical" } } },
            { "type": "value", "options": { "Warning":  { "color": "orange", "index": 1, "text": "Warning" } } },
            { "type": "value", "options": { "Advisory": { "color": "yellow", "index": 2, "text": "Advisory" } } },
            { "type": "value", "options": { "Normal":   { "color": "green",  "index": 3, "text": "Normal" } } }
          ],
          "unit": "string"
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "id": 2,
      "type": "gauge",
      "title": "Risk Score",
      "datasource": { "type": "postgres", "uid": "omnipdm-tsdb" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT risk_score AS value FROM predictions WHERE device_id = '$device_id' ORDER BY time DESC LIMIT 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 0.4 },
              { "color": "orange", "value": 0.7 },
              { "color": "red",    "value": 0.9 }
            ]
          },
          "min": 0,
          "max": 1,
          "unit": "short",
          "decimals": 3
        }
      },
      "options": {
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "id": 3,
      "type": "gauge",
      "title": "RUL (정규화 0~1, 낮을수록 임박)",
      "datasource": { "type": "postgres", "uid": "omnipdm-tsdb" },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "description": "Remaining Useful Life 정규화 값. 0=즉시 고장 예상, 1=충분한 잔여수명. AI4I CNN 은 사용 안 함(항상 1.0).",
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT rul_norm AS value FROM predictions WHERE device_id = '$device_id' ORDER BY time DESC LIMIT 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",    "value": null },
              { "color": "orange", "value": 0.3 },
              { "color": "yellow", "value": 0.6 },
              { "color": "green",  "value": 0.85 }
            ]
          },
          "min": 0,
          "max": 1,
          "unit": "short",
          "decimals": 3
        }
      },
      "options": {
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "고장 확률",
      "datasource": { "type": "postgres", "uid": "omnipdm-tsdb" },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT failure_probability AS value FROM predictions WHERE device_id = '$device_id' ORDER BY time DESC LIMIT 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 0.3 },
              { "color": "orange", "value": 0.5 },
              { "color": "red",    "value": 0.8 }
            ]
          },
          "unit": "percentunit",
          "decimals": 1,
          "min": 0,
          "max": 1
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "id": 5,
      "type": "table",
      "title": "Live Telemetry (최신 센서 값)",
      "datasource": { "type": "postgres", "uid": "omnipdm-tsdb" },
      "gridPos": { "h": 10, "w": 8, "x": 0, "y": 5 },
      "description": "선택된 장비의 가장 최근 telemetry payload 를 센서별로 펼쳐 표시. dataset_key 별로 키 구성이 다름.",
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "WITH latest AS (SELECT sensors, time FROM telemetry WHERE device_id = '$device_id' ORDER BY time DESC LIMIT 1) SELECT j.key AS \"센서\", j.value::text AS \"값\", latest.time AS \"수신시각\" FROM latest, jsonb_each(latest.sensors) j"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "left", "displayMode": "auto" }
        }
      },
      "options": {
        "showHeader": true,
        "footer": { "show": false, "reducer": ["sum"], "fields": "" }
      }
    },
    {
      "id": 6,
      "type": "bargauge",
      "title": "XAI 기여도 (Top Contributors)",
      "datasource": { "type": "postgres", "uid": "omnipdm-tsdb" },
      "gridPos": { "h": 10, "w": 8, "x": 8, "y": 5 },
      "description": "최신 예측에서 위험도에 가장 크게 기여한 센서/특성. 형식: [[이름, 값], ...] JSONB. 빈 배열은 자동 제외.",
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "WITH latest AS (SELECT top_contributors FROM predictions WHERE device_id = '$device_id' AND top_contributors IS NOT NULL AND jsonb_array_length(top_contributors) > 0 ORDER BY time DESC LIMIT 1) SELECT elem->>0 AS metric, (elem->>1)::numeric AS value FROM latest, jsonb_array_elements(latest.top_contributors) AS elem"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "continuous-YlOrRd" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 0.4 },
              { "color": "orange", "value": 0.7 }
            ]
          },
          "unit": "short",
          "decimals": 3
        }
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showUnfilled": true
      }
    },
    {
      "id": 7,
      "type": "table",
      "title": "이 장비의 알람 이력 (최근 1시간)",
      "datasource": { "type": "postgres", "uid": "omnipdm-tsdb" },
      "gridPos": { "h": 10, "w": 8, "x": 16, "y": 5 },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT time, risk_level, round(risk_score::numeric, 3) AS risk_score, channel, notify_result FROM alerts WHERE device_id = '$device_id' AND time > now() - interval '1 hour' ORDER BY time DESC LIMIT 100"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "left", "displayMode": "auto" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "risk_level" },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  { "type": "value", "options": { "Critical": { "color": "red",    "index": 0 } } },
                  { "type": "value", "options": { "Warning":  { "color": "orange", "index": 1 } } },
                  { "type": "value", "options": { "Advisory": { "color": "yellow", "index": 2 } } },
                  { "type": "value", "options": { "Normal":   { "color": "green",  "index": 3 } } }
                ]
              },
              { "id": "custom.displayMode", "value": "color-background" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "notify_result" },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  { "type": "value", "options": { "SENT":         { "color": "green",  "index": 0 } } },
                  { "type": "value", "options": { "FILTERED":     { "color": "gray",   "index": 1 } } },
                  { "type": "value", "options": { "RATE_LIMITED": { "color": "yellow", "index": 2 } } },
                  { "type": "value", "options": { "FAILED":       { "color": "red",    "index": 3 } } }
                ]
              },
              { "id": "custom.displayMode", "value": "color-background" }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "footer": { "show": false, "reducer": ["sum"], "fields": "" }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Risk Score 추세 ($device_id)",
      "datasource": { "type": "postgres", "uid": "omnipdm-tsdb" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 15 },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT time AS \"time\", risk_score AS \"risk_score\", failure_probability AS \"failure_prob\" FROM predictions WHERE $__timeFilter(time) AND device_id = '$device_id' ORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "never",
            "spanNulls": true
          },
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 0.4 },
              { "color": "orange", "value": 0.7 },
              { "color": "red",    "value": 0.9 }
            ]
          },
          "unit": "short"
        }
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "센서 시계열 ($device_id) — JSONB 자동 펼침",
      "datasource": { "type": "postgres", "uid": "omnipdm-tsdb" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 15 },
      "description": "telemetry.sensors JSONB 의 모든 numeric key 를 자동으로 series 로 펼침. 센서 단위는 dataset_key 마다 다르므로 절대값보다 추세 변화에 집중.",
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT t.time AS \"time\", j.key AS metric, (j.value)::text::numeric AS value FROM telemetry t, jsonb_each(t.sensors) j WHERE $__timeFilter(t.time) AND t.device_id = '$device_id' AND jsonb_typeof(j.value) = 'number' ORDER BY t.time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 5,
            "showPoints": "never",
            "spanNulls": true
          }
        }
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    }
  ]
}
