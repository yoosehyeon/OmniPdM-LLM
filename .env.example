# Groq (Llama 3.3 70B, OpenAI 호환 endpoint)
# 발급: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.2
GROQ_MAX_TOKENS=800
# 기본 endpoint 는 OpenAI 호환 경로. 커스텀 프록시가 없다면 수정 불필요.
GROQ_BASE_URL=https://api.groq.com/openai/v1

# 시스템 프롬프트 파일 위치
PROMPT_DIR=prompts

# LLM-as-Judge 활성화 (옵션, 활성 시 추가 API 호출 발생)
# 1 로 설정 시 LLM 출력 품질을 LLM 으로 재검증
ENABLE_LLM_JUDGE=0

# LLM 스트리밍 응답 (P3-①)
# 1 로 설정 시 UI 계층에서 generate_stream() 사용 (서비스 계층 메서드는 값 무관하게 항상 제공)
ENABLE_LLM_STREAM=0
