# OmniPdM 환경변수 예시. README "환경변수" 표와 1:1 동기화.
# 사용: 이 파일을 .env 로 복사 후 비밀값 채움.

# ─── LLM (Groq, Llama 3.3 70B, OpenAI 호환 endpoint) ───────────────────────────
# 발급: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.2
GROQ_MAX_TOKENS=800
GROQ_BASE_URL=https://api.groq.com/openai/v1

# 시스템 프롬프트 디렉터리
PROMPT_DIR=prompts

# LLM-as-Judge — 1 활성화 시 출력 품질을 LLM 으로 재검증 (추가 API 호출 발생)
ENABLE_LLM_JUDGE=0
# 토큰 스트리밍
ENABLE_LLM_STREAM=0
# Function Calling 5 tools (services/llm_tools.py)
ENABLE_LLM_TOOLS=0

# 체크포인트 fallback: 로컬 우선, 미존재 시 HF Hub 에서 pull.
CHECKPOINT_REPO=yusehyeon/hybridpdm-checkpoints

# ─── Flask / React 서빙 (PRD v7.0) ─────────────────────────────────────────────
OMNIPDM_HOST=0.0.0.0
OMNIPDM_PORT=8050
OMNIPDM_DEBUG=false

# 세션 쿠키 서명. **운영 환경 필수** — 미설정 시 재시작마다 세션 무효화.
#   생성:  python -c "import secrets; print(secrets.token_urlsafe(32))"
OMNIPDM_SECRET_KEY=

# 인증 가드 — false 로 두면 인증 비활성 (dev/test 전용).
OMNIPDM_AUTH_REQUIRED=true
# HTTPS 운영 시 true.
OMNIPDM_SESSION_COOKIE_SECURE=false

# ─── DB (TimescaleDB) ─────────────────────────────────────────────────────────
# docker-compose 사용 시 호스트는 timescaledb (서비스 이름).
OMNIPDM_DB_ENABLED=true
OMNIPDM_DB_HOST=127.0.0.1
OMNIPDM_DB_PORT=5432
OMNIPDM_DB_NAME=omnipdm
OMNIPDM_DB_USER=omnipdm
OMNIPDM_DB_PASSWORD=omnipdm

# ─── MQTT (실시간 Worker, T1-01) ───────────────────────────────────────────────
OMNIPDM_MQTT_HOST=localhost
OMNIPDM_MQTT_PORT=1883
OMNIPDM_MQTT_USERNAME=
OMNIPDM_MQTT_PASSWORD=
OMNIPDM_MQTT_TOPIC=omnipdm/telemetry/+
OMNIPDM_MQTT_CLIENT_ID=omnipdm-worker
OMNIPDM_MQTT_QOS=1
OMNIPDM_MQTT_KEEPALIVE_SEC=60

# 알람 임계 (T1-02). Critical/Warning 만 외부 채널 전송.
OMNIPDM_ALERT_MIN_LEVEL=Critical
OMNIPDM_ALERT_RATE_LIMIT_SEC=300

# ─── MLflow ───────────────────────────────────────────────────────────────────
DISABLE_MLFLOW=0
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
